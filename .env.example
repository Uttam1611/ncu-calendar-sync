# Copy this file to .env and fill in values from the NCU portal's Network tab.
# Never commit .env or share it: it may contain private endpoint details.

NCU_LOGIN_URL=https://uatapi.ncuindia.edu/api/Authentication/ValidateUser
NCU_SCHEDULE_URL=https://uatapi.ncuindia.edu/api/myapp/Student/GetSchedule

# These are the JSON property names used by the portal's ValidateUser request body.
# Replace the example names with the exact field names seen in DevTools Payload.
NCU_USERNAME_FIELD=UserName
NCU_PASSWORD_FIELD=Password

# Optional additional JSON fields needed by ValidateUser, formatted as JSON.
# Example: NCU_LOGIN_EXTRA_JSON={"someFlag":true}
# Keep the exact additional fields observed in the portal request.
NCU_LOGIN_EXTRA_JSON={"IpAddress":"","UserType":""}

# Response field names observed in ValidateUser. Adjust only if the API differs.
NCU_TOKEN_FIELD=token
NCU_USER_OBJECT_FIELD=User
NCU_USER_ID_FIELD=UserId

# Portal uses Authorization: Bearer <token> according to your inspection.
NCU_AUTH_SCHEME=Bearer

# Use the official Google Calendar API OAuth desktop-client credentials file.
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=google_token.json
GOOGLE_CALENDAR_NAME=College
SYNC_STATE_FILE=sync_state.json
TIMEZONE=Asia/Kolkata
